diff --git a/server/testutil/testenv/testenv_test.go b/server/testutil/testenv/testenv_test.go
new file mode 100644
index 000000000..a83c33f7c
--- /dev/null
+++ b/server/testutil/testenv/testenv_test.go
@@ -0,0 +1,67 @@
+package testenv_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/buildbuddy-io/buildbuddy/server/interfaces"
+	"github.com/buildbuddy-io/buildbuddy/server/testutil/testenv"
+	"github.com/stretchr/testify/require"
+)
+
+type trackedHandle struct {
+	interfaces.DBHandle
+	closes int
+}
+
+func (h *trackedHandle) Close() error {
+	h.closes++
+	return h.DBHandle.Close()
+}
+
+func TestDBHandleOwnership(t *testing.T) {
+	for _, borrowed := range []bool{false, true} {
+		name := "owned"
+		if borrowed {
+			name = "borrowed"
+		}
+		t.Run(name, func(t *testing.T) {
+			owner := testenv.GetTestEnv(t)
+			handle := &trackedHandle{DBHandle: owner.GetDBHandle()}
+			t.Run("cleanup", func(t *testing.T) {
+				opt := testenv.WithDBHandle(handle)
+				if borrowed {
+					opt = testenv.WithBorrowedDBHandle(handle)
+				}
+				env := testenv.GetTestEnv(t, opt)
+				require.Same(t, handle, env.GetDBHandle())
+			})
+			if borrowed {
+				require.Zero(t, handle.closes)
+				// The shared database must remain usable after borrower cleanup.
+				var value int
+				err := handle.NewQuery(context.Background(), "borrowed_handle_test").Raw("SELECT 1").Take(&value)
+				require.NoError(t, err)
+				require.Equal(t, 1, value)
+			} else {
+				require.Equal(t, 1, handle.closes)
+			}
+		})
+	}
+}
+
+// BenchmarkDBHandleSetup compares the old discarded-DB setup path with borrowing.
+// Use a fixed iteration count to bound resources retained until benchmark cleanup.
+func BenchmarkDBHandleSetup(b *testing.B) {
+	owner := testenv.GetTestEnv(b)
+	b.Run("create_and_migrate", func(b *testing.B) {
+		for i := 0; i < b.N; i++ {
+			testenv.GetTestEnv(b)
+		}
+	})
+	b.Run("borrow", func(b *testing.B) {
+		for i := 0; i < b.N; i++ {
+			testenv.GetTestEnv(b, testenv.WithBorrowedDBHandle(owner.GetDBHandle()))
+		}
+	})
+}
