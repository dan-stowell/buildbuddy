+//enterprise/server/cmd/executor:executor_lib
+//enterprise/server/cmd/metadata_server:metadata_server_lib
+//enterprise/server/cmd/server:buildbuddy
+//enterprise/server/cmd/server:server_lib
+//enterprise/server/usagealert:usagealert_lib
+//enterprise/server/vmexec:vmexec
+//enterprise/tools/metronome_exporter:metronome_exporter_lib
+//enterprise/tools/mount_vfs:mount_vfs_lib
+//enterprise/tools/replay_action:replay_action_lib
+//enterprise/tools/vmstart:vmstart_lib
+//server/cmd/buildbuddy:buildbuddy
+//server/cmd/buildbuddy:buildbuddy_lib
+//server/http/interceptors:interceptors_test
+//server/interfaces
