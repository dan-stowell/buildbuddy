+// Run the picker in a subprocess so readline sees real terminal file descriptors.
+func TestDetermineRemote_PTY(t *testing.T) {
+	if os.Getenv("BB_REMOTE_PICKER_HELPER") == "1" {
+		r, err := determineRemote()
+		if err != nil {
+			fmt.Printf("error: %s\n", err)
+		} else {
+			fmt.Printf("remote: %s %s\n", r.name, r.url)
+		}
+		return
+	}
+	for _, tc := range []struct {
+		name, input, cached, want string
+	}{
+		{"default", "\r", "", "remote: extra https://example.com/extra"},
+		{"next", "\x1b[B\r", "", "remote: origin https://example.com/origin"},
+		{"search", "ORIGIN\r", "", "remote: origin https://example.com/origin"},
+		{"URL search", "HTTPS://EXAMPLE.COM/ORIGIN\r", "", "remote: origin https://example.com/origin"},
+		{"stale cache", "\x1b[B\r", "deleted", "remote: origin https://example.com/origin"},
+		{"cancel", "\x03", "", "error: select git remote: ^C"},
+		{"cached", "", "origin", "remote: origin https://example.com/origin"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo, _ := testgit.MakeTempRepo(t, map[string]string{"README": "test"})
+			testshell.Run(t, repo, "git remote add extra https://example.com/extra && git remote add origin https://example.com/origin")
+			if tc.cached != "" {
+				testshell.Run(t, repo, fmt.Sprintf("git config %s.%s %s", gitConfigSection, gitConfigRemoteBazelRemote, tc.cached))
+			}
+			master, tty, err := pty.Open()
+			require.NoError(t, err)
+			defer master.Close()
+			defer tty.Close()
+			require.NoError(t, pty.Setsize(master, &pty.Winsize{Rows: 24, Cols: 120}))
+			before, err := term.GetState(int(tty.Fd()))
+			require.NoError(t, err)
+			ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestDetermineRemote_PTY$")
+			cmd.Dir = repo
+			cmd.Env = append(os.Environ(), "BB_REMOTE_PICKER_HELPER=1")
+			var stdout bytes.Buffer
+			cmd.Stdin, cmd.Stderr, cmd.Stdout = tty, tty, &stdout
+			output := lockingbuffer.New()
+			go func() { _, _ = io.Copy(output, master) }()
+			require.NoError(t, cmd.Start())
+			if tc.input != "" {
+				// Wait until the prompt is rendered and raw mode is enabled before typing.
+				require.Eventually(t, func() bool {
+					return strings.Contains(output.String(), "example.com/origin")
+				}, 10*time.Second, 10*time.Millisecond)
+				_, err = master.Write([]byte(tc.input))
+				require.NoError(t, err)
+			}
+			require.NoError(t, cmd.Wait(), output.String())
+			require.Contains(t, stdout.String(), tc.want)
+			require.NotContains(t, stdout.String(), "Select the git remote")
+			after, err := term.GetState(int(tty.Fd()))
+			require.NoError(t, err)
+			require.Equal(t, before, after, "picker must restore terminal settings")
+			cached := testshell.Run(t, repo, fmt.Sprintf("git config --get %s.%s || true", gitConfigSection, gitConfigRemoteBazelRemote))
+			if tc.name == "cancel" {
+				require.Empty(t, strings.TrimSpace(cached))
+			} else {
+				selected := strings.Fields(tc.want)[1]
+				require.Equal(t, selected, strings.TrimSpace(cached))
+			}
+		})
+	}
+}
+
