+// Wait for a probe's filesystem timestamps, as observed by the cache, to move
+// past both reference values. Wall-clock time alone does not account for the
+// filesystem's timestamp precision (or a cached filesystem clock).
+func waitForTimestampAdvance(t *testing.T, ctx context.Context, dc *disk_cache.DiskCache, accessUsec, modifyUsec int64) {
+	t.Helper()
+	// Use a separate instance so even a matching digest cannot touch test data.
+	probe, buf := testdigest.NewRandomResourceAndBuf(t, 1, rspb.CacheType_AC, "timestamp-probe")
+	defer func() {
+		require.NoError(t, dc.Delete(ctx, probe))
+	}()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		require.NoError(t, dc.Set(ctx, probe, buf))
+		md, err := dc.Metadata(ctx, probe)
+		require.NoError(t, err)
+		if md.LastAccessTimeUsec > accessUsec && md.LastModifyTimeUsec > modifyUsec {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	require.FailNow(t, "filesystem timestamps did not advance")
+}
