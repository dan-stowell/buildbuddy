+func requireAllFieldsPopulated(t testing.TB, msg protoreflect.Message) {
+	t.Helper()
+	fields := msg.Descriptor().Fields()
+	for i := 0; i < fields.Len(); i++ {
+		field := fields.Get(i)
+		require.True(t, msg.Has(field), "fixture omits %s", field.FullName())
+		if field.Message() == nil {
