+		}
+		if field.IsList() {
+			list := msg.Get(field).List()
+			for j := 0; j < list.Len(); j++ {
+				requireAllFieldsPopulated(t, list.Get(j).Message())
+			}
+		} else {
+			requireAllFieldsPopulated(t, msg.Get(field).Message())
+		}
 	}
