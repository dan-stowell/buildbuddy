index 000000000..b57dcccbe
--- /dev/null
+++ b/enterprise/server/oci/ociconv/metrics.go
@@ -0,0 +1,138 @@
+package ociconv
+
+import (
+	"container/list"
+	"context"
+	"sync"
+	"sync/atomic"
+
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/buildbuddy-io/buildbuddy/server/util/flag"
+	"github.com/buildbuddy-io/buildbuddy/server/util/hash"
+)
+
+var trackConversionKeys = flag.Bool("executor.ext4_conversion_track_keys", false, "Track recently converted filecache keys and concurrent credential overlap for metrics. Default off: adds request-path bookkeeping; history and active flight hashes are each bounded to 4096 entries. History loss and active overflow can undercount.")
+
+const trackedKeyLimit = 4096
+
+type keyTracker struct {
+	mu            sync.Mutex
+	limit         int
+	recent        map[string]*list.Element
+	order         list.List
+	active        map[string]map[string]int
+	activeEntries int
+}
+
+var conversionKeys = keyTracker{limit: trackedKeyLimit}
+
+// begin is called only inside singleflight after a cache miss. Active
+// flights with distinct credential hashes identify credential overlap.
+// Hashes are retained only while active; raw credentials are never retained.
+func (t *keyTracker) begin(key, flight string) (bool, bool, func()) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.recent == nil {
+		t.recent = make(map[string]*list.Element)
+	}
+	if t.active == nil {
+		t.active = make(map[string]map[string]int)
+	}
+	e, recent := t.recent[key]
+	if recent {
+		t.order.MoveToFront(e)
+	}
+	flights := t.active[key]
+	n := flights[flight]
+	overlap := len(flights) > 0 && (n == 0 || len(flights) > 1)
+	if n == 0 && t.activeEntries >= t.limit {
+		return recent, overlap, func() {}
+	}
+	if flights == nil {
+		flights = make(map[string]int)
+		t.active[key] = flights
+	}
+	if n == 0 {
+		t.activeEntries++
+	}
+	flights[flight]++
+	return recent, overlap, func() {
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		flights[flight]--
+		if flights[flight] == 0 {
+			delete(flights, flight)
+			t.activeEntries--
+		}
+		if len(flights) == 0 {
+			delete(t.active, key)
+		}
+	}
+}
+
+func (t *keyTracker) converted(key string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.recent == nil {
+		t.recent = make(map[string]*list.Element)
+	}
+	if e := t.recent[key]; e != nil {
+		t.order.MoveToFront(e)
+		return
+	}
+	t.recent[key] = t.order.PushFront(key)
+	if t.order.Len() > t.limit {
+		e := t.order.Back()
+		delete(t.recent, e.Value.(string))
+		t.order.Remove(e)
+	}
+}
+
+func observeConversion(keyParts []string, flight string, filecache bool) func(bool) {
+	metrics.Ext4ImageConversions.Inc()
+	if !*trackConversionKeys {
+		return func(bool) {}
+	}
+	key := hash.Strings(keyParts...)
+	recent, overlap, done := conversionKeys.begin(key, flight)
+	label := "false"
+	if recent {
+		label = "true"
+	}
+	if filecache {
+		metrics.Ext4ImageReConversions.WithLabelValues(label).Inc()
+	}
+	if overlap {
+		metrics.Ext4ImageCredentialOverlap.WithLabelValues("bounded").Inc()
+	}
+	return func(success bool) {
+		if success && filecache {
+			conversionKeys.converted(key)
+		}
+		done()
+	}
+}
+
+func observeLookup(method string, hit bool, err error) {
+	label := "miss"
+	if err != nil {
+		label = "error"
+	} else if hit {
+		label = "hit"
+	}
+	metrics.Ext4ImageCacheLookups.WithLabelValues(method, label).Inc()
+}
+
+// doConversionFlight counts completed deduplicated callers, excluding the
+// executing caller and callers whose contexts were canceled while waiting.
+func doConversionFlight(ctx context.Context, key string, fn func(context.Context) (string, error)) (string, error) {
+	var executed atomic.Bool
+	out, shared, err := conversionGroup.Do(ctx, key, func(ctx context.Context) (string, error) {
+		executed.Store(true)
+		return fn(ctx)
+	})
+	if shared && !executed.Load() && ctx.Err() == nil {
+		metrics.Ext4ImageDedupedWaiters.Inc()
+	}
+	return out, err
+}
