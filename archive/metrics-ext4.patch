diff --git a/enterprise/server/util/ext4/metrics.go b/enterprise/server/util/ext4/metrics.go
new file mode 100644
index 000000000..a3435bdb4
--- /dev/null
+++ b/enterprise/server/util/ext4/metrics.go
@@ -0,0 +1,174 @@
+//go:build linux && !android
+
+package ext4
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/buildbuddy-io/buildbuddy/server/util/flag"
+)
+
+var sampleProcessIO = flag.Bool("executor.ext4_conversion_sample_process_io", false, "Sample /proc/self/io before and after ext4 conversion phases. Default off: adds local reads on the request path; deltas include unrelated concurrent executor IO.")
+var sampleImageSize = flag.Bool("executor.ext4_conversion_sample_image_size", false, "Record apparent and allocated ext4 image sizes. Default off: adds one local stat lookup per successful conversion on the request path.")
+var mke2fsVersion versionRecorder
+
+type versionRecorder struct{ once sync.Once }
+
+type conversionMetricsKey struct{}
+
+var conversionPhases = [...]string{"extract", "size", "mke2fs", "filecache_add", "cleanup"}
+
+type phaseAccounting struct {
+	duration       time.Duration
+	bytes          [2][2]int64 // source (child/process), direction (read/write)
+	valid          [2]bool
+	processInvalid bool
+}
+
+type conversionAccounting struct {
+	phases [len(conversionPhases)]phaseAccounting
+	once   sync.Once
+}
+
+// StartConversionMetrics owns one conversion's observations. Nested calls reuse
+// the accounting object and return a no-op finish. The owner must defer finish
+// before registering cleanup defers, so all cleanup scopes are included.
+// Unreached phases have zero duration; unavailable IO observations are omitted.
+func StartConversionMetrics(ctx context.Context) (context.Context, func()) {
+	if _, ok := ctx.Value(conversionMetricsKey{}).(*conversionAccounting); ok {
+		return ctx, func() {}
+	}
+	accounting := &conversionAccounting{}
+	return context.WithValue(ctx, conversionMetricsKey{}, accounting), func() {
+		accounting.once.Do(func() {
+			for i, phase := range conversionPhases {
+				p := &accounting.phases[i]
+				metrics.Ext4ImagePhaseDurationUsec.WithLabelValues(phase).Observe(float64(p.duration.Microseconds()))
+				for source, label := range []string{"child_rusage", "process"} {
+					if !p.valid[source] || (source == 1 && p.processInvalid) {
+						continue
+					}
+					for direction, labelDirection := range []string{"read", "write"} {
+						metrics.Ext4ImagePhaseIOBytes.WithLabelValues(phase, label, labelDirection).Observe(float64(p.bytes[source][direction]))
+					}
+				}
+			}
+		})
+	}
+}
+
+func processIO() (map[string]int64, bool) {
+	b, err := os.ReadFile("/proc/self/io")
+	if err != nil {
+		return nil, false
+	}
+	return parseProcessIO(string(b))
+}
+
+func parseProcessIO(contents string) (map[string]int64, bool) {
+	m := make(map[string]int64)
+	for line := range strings.SplitSeq(contents, "\n") {
+		f := strings.Fields(line)
+		if len(f) != 2 {
+			continue
+		}
+		v, err := strconv.ParseInt(f[1], 10, 64)
+		if err == nil {
+			m[strings.TrimSuffix(f[0], ":")] = v
+		}
+	}
+	_, r := m["read_bytes"]
+	_, w := m["write_bytes"]
+	return m, r && w
+}
+
+// ObservePhase records elapsed time and child physical IO even on failure.
+// Optional process deltas must not be added to child IO: /proc/self/io may
+// include reaped children, and other goroutines can do IO during the phase.
+func ObservePhase(ctx context.Context, phase string) func(*exec.Cmd) {
+	accounting, ok := ctx.Value(conversionMetricsKey{}).(*conversionAccounting)
+	if !ok {
+		return func(*exec.Cmd) {}
+	}
+	var p *phaseAccounting
+	for i, name := range conversionPhases {
+		if name == phase {
+			p = &accounting.phases[i]
+			break
+		}
+	}
+	if p == nil {
+		return func(*exec.Cmd) {}
+	}
+	start := time.Now()
+	var before map[string]int64
+	var validBefore bool
+	sample := *sampleProcessIO
+	if sample {
+		before, validBefore = processIO()
+	}
+	return func(cmd *exec.Cmd) {
+		p.duration += time.Since(start)
+		if cmd != nil && cmd.ProcessState != nil {
+			if r, _ := cmd.ProcessState.SysUsage().(*syscall.Rusage); r != nil {
+				p.valid[0] = true
+				p.bytes[0][0] += r.Inblock * 512
+				p.bytes[0][1] += r.Oublock * 512
+			}
+		}
+		if sample {
+			after, validAfter := processIO()
+			if !validBefore || !validAfter || after["read_bytes"] < before["read_bytes"] || after["write_bytes"] < before["write_bytes"] {
+				p.processInvalid = true
+			} else {
+				p.valid[1] = true
+				p.bytes[1][0] += after["read_bytes"] - before["read_bytes"]
+				p.bytes[1][1] += after["write_bytes"] - before["write_bytes"]
+			}
+		}
+	}
+}
+
+func observeVersion() {
+	mke2fsVersion.record(func(ctx context.Context) ([]byte, error) {
+		return exec.CommandContext(ctx, mke2fsPath, "-V").CombinedOutput()
+	})
+}
+
+func (r *versionRecorder) record(run func(context.Context) ([]byte, error)) {
+	r.once.Do(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		out, err := run(ctx)
+		if err != nil {
+			return
+		}
+		fields := strings.Fields(string(out))
+		if len(fields) >= 2 && fields[0] == "mke2fs" {
+			metrics.Ext4Mke2fsVersion.WithLabelValues(fields[1]).Set(1)
+		}
+	})
+}
+
+// ObserveImageSize records apparent and allocated bytes without affecting errors.
+func ObserveImageSize(path string) {
+	if !*sampleImageSize {
+		return
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return
+	}
+	metrics.Ext4ImageSizeBytes.WithLabelValues("apparent").Observe(float64(info.Size()))
+	if st, ok := info.Sys().(*syscall.Stat_t); ok {
+		metrics.Ext4ImageSizeBytes.WithLabelValues("allocated").Observe(float64(st.Blocks) * 512)
+	}
+}
diff --git a/enterprise/server/util/ext4/metrics_test.go b/enterprise/server/util/ext4/metrics_test.go
new file mode 100644
index 000000000..73e7fb5b9
--- /dev/null
+++ b/enterprise/server/util/ext4/metrics_test.go
@@ -0,0 +1,217 @@
+//go:build linux && !android
+
+package ext4
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/buildbuddy-io/buildbuddy/server/util/testing/flags"
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+)
+
+func TestParseProcessIO(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		valid bool
+	}{
+		{"read_bytes: 512\nwrite_bytes: 1024\nrchar: 999\n", true},
+		{"read_bytes: 0\nwrite_bytes: 0\n", true},
+		{"read_bytes: invalid\nwrite_bytes: 12\n", false},
+		{"rchar: 512\nwchar: 1024\n", false},
+		{"", false},
+	} {
+		_, valid := parseProcessIO(tc.input)
+		if valid != tc.valid {
+			t.Errorf("parseProcessIO(%q): valid=%v", tc.input, valid)
+		}
+	}
+	values, _ := parseProcessIO("read_bytes: 512\nwrite_bytes: 1024\n")
+	if values["read_bytes"] != 512 || values["write_bytes"] != 1024 {
+		t.Fatal("incorrect byte counters")
+	}
+}
+
+func histogramCount(t *testing.T, metric prometheus.Observer) uint64 {
+	t.Helper()
+	m := &dto.Metric{}
+	if err := metric.(prometheus.Metric).Write(m); err != nil {
+		t.Fatal(err)
+	}
+	return m.GetHistogram().GetSampleCount()
+}
+
+func TestObservePhaseScopedAndFailedChild(t *testing.T) {
+	flags.Set(t, "executor.ext4_conversion_sample_process_io", false)
+	phase := "extract"
+	duration := metrics.Ext4ImagePhaseDurationUsec.WithLabelValues(phase)
+	before := histogramCount(t, duration)
+	ObservePhase(context.Background(), phase)(nil)
+	if histogramCount(t, duration) != before {
+		t.Fatal("unscoped operation recorded as conversion")
+	}
+	ctx, finish := StartConversionMetrics(context.Background())
+	cmd := exec.Command("/bin/sh", "-c", "exit 1")
+	observe := ObservePhase(ctx, phase)
+	if err := cmd.Run(); err == nil {
+		t.Fatal("expected child failure")
+	}
+	io := metrics.Ext4ImagePhaseIOBytes.WithLabelValues(phase, "child_rusage", "read")
+	beforeIO := histogramCount(t, io)
+	observe(cmd)
+	finish()
+	if histogramCount(t, duration) != before+1 || histogramCount(t, io) != beforeIO+1 {
+		t.Fatal("failed child phase was not recorded")
+	}
+}
+
+func histogramSnapshot(t *testing.T, metric prometheus.Observer) *dto.Histogram {
+	t.Helper()
+	m := &dto.Metric{}
+	if err := metric.(prometheus.Metric).Write(m); err != nil {
+		t.Fatal(err)
+	}
+	return m.GetHistogram()
+}
+
+func TestConversionAccountingAggregatesScopesAndFlushesOnce(t *testing.T) {
+	flags.Set(t, "executor.ext4_conversion_sample_process_io", true)
+	before := make(map[string]uint64)
+	beforeIO := make(map[string]uint64)
+	for _, phase := range conversionPhases {
+		before[phase] = histogramCount(t, metrics.Ext4ImagePhaseDurationUsec.WithLabelValues(phase))
+		beforeIO[phase] = histogramCount(t, metrics.Ext4ImagePhaseIOBytes.WithLabelValues(phase, "process", "write"))
+	}
+	ctx, finish := StartConversionMetrics(context.Background())
+	nested, nestedFinish := StartConversionMetrics(ctx)
+	for _, phase := range conversionPhases {
+		ObservePhase(nested, phase)(nil)
+	}
+	// The two independent cleanup sites share the same accounting record.
+	ObservePhase(ctx, "cleanup")(nil)
+	nestedFinish()
+	if histogramCount(t, metrics.Ext4ImagePhaseDurationUsec.WithLabelValues("cleanup")) != before["cleanup"] {
+		t.Fatal("nested scope flushed prematurely")
+	}
+	finish()
+	finish()
+	for _, phase := range conversionPhases {
+		if histogramCount(t, metrics.Ext4ImagePhaseDurationUsec.WithLabelValues(phase)) != before[phase]+1 {
+			t.Fatalf("phase %s was not recorded exactly once", phase)
+		}
+		if histogramCount(t, metrics.Ext4ImagePhaseIOBytes.WithLabelValues(phase, "process", "write")) != beforeIO[phase]+1 {
+			t.Fatalf("process IO for %s was not recorded exactly once", phase)
+		}
+	}
+}
+
+func TestEnabledProcessIOAndImageSizes(t *testing.T) {
+	flags.Set(t, "executor.ext4_conversion_sample_process_io", true)
+	flags.Set(t, "executor.ext4_conversion_sample_image_size", true)
+	ctx, finish := StartConversionMetrics(context.Background())
+	read := metrics.Ext4ImagePhaseIOBytes.WithLabelValues("extract", "process", "read")
+	write := metrics.Ext4ImagePhaseIOBytes.WithLabelValues("extract", "process", "write")
+	readBefore := histogramSnapshot(t, read)
+	writeBefore := histogramSnapshot(t, write)
+	observe := ObservePhase(ctx, "extract")
+	path := filepath.Join(t.TempDir(), "sparse-image")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Truncate(1 << 20); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.WriteAt([]byte("ext4"), 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.ReadFile(path); err != nil {
+		t.Fatal(err)
+	}
+	observe(nil)
+	finish()
+	for _, pair := range []struct {
+		metric prometheus.Observer
+		before *dto.Histogram
+	}{{read, readBefore}, {write, writeBefore}} {
+		after := histogramSnapshot(t, pair.metric)
+		if after.GetSampleCount() != pair.before.GetSampleCount()+1 || after.GetSampleSum() < pair.before.GetSampleSum() {
+			t.Fatal("enabled IO sampling did not report a nonnegative delta")
+		}
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expectedSizes := map[string]int64{"apparent": info.Size(), "allocated": info.Sys().(*syscall.Stat_t).Blocks * 512}
+	beforeSizes := make(map[string]*dto.Histogram)
+	for kind := range expectedSizes {
+		beforeSizes[kind] = histogramSnapshot(t, metrics.Ext4ImageSizeBytes.WithLabelValues(kind))
+	}
+	ObserveImageSize(path)
+	for kind, expected := range expectedSizes {
+		after := histogramSnapshot(t, metrics.Ext4ImageSizeBytes.WithLabelValues(kind))
+		before := beforeSizes[kind]
+		if after.GetSampleSum()-before.GetSampleSum() != float64(expected) || after.GetSampleCount() != before.GetSampleCount()+1 {
+			t.Fatalf("incorrect %s image size", kind)
+		}
+	}
+	flags.Set(t, "executor.ext4_conversion_sample_image_size", false)
+	h := metrics.Ext4ImageSizeBytes.WithLabelValues("apparent")
+	before := histogramCount(t, h)
+	ObserveImageSize(path)
+	if histogramCount(t, h) != before {
+		t.Fatal("disabled size sampling emitted an observation")
+	}
+}
+
+func TestVersionGaugeReportedOnce(t *testing.T) {
+	var recorder versionRecorder
+	calls := 0
+	run := func(context.Context) ([]byte, error) {
+		calls++
+		return []byte("mke2fs test-once (date)\nUsing EXT2FS Library version test-once\n"), nil
+	}
+	recorder.record(run)
+	gauge := metrics.Ext4Mke2fsVersion.WithLabelValues("test-once")
+	m := &dto.Metric{}
+	if err := gauge.Write(m); err != nil {
+		t.Fatal(err)
+	}
+	if m.GetGauge().GetValue() != 1 {
+		t.Fatal("version gauge missing")
+	}
+	gauge.Set(0)
+	recorder.record(run)
+	if err := gauge.Write(m); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 || m.GetGauge().GetValue() != 0 {
+		t.Fatal("version command or gauge was recorded more than once")
+	}
+	observeVersion()
+	out, err := exec.Command(mke2fsPath, "-V").CombinedOutput()
+	if err != nil {
+		t.Fatal(err)
+	}
+	version := strings.Fields(string(out))[1]
+	if err := metrics.Ext4Mke2fsVersion.WithLabelValues(version).Write(m); err != nil {
+		t.Fatal(err)
+	}
+	if m.GetGauge().GetValue() != 1 {
+		t.Fatal("installed e2fsprogs version not reported")
+	}
+}
