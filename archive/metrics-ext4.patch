+
+func TestKeyTrackerHistoryAndOverlap(t *testing.T) {
+	tr := keyTracker{limit: 2}
+	recent, overlap, end := tr.begin("a", "creds1")
+	if recent || overlap {
+		t.Fatal("new key reported as recent or overlapping")
+	}
+	_, overlap, end2 := tr.begin("a", "creds2")
+	if !overlap {
+		t.Fatal("missing credential overlap")
+	}
+	end2()
+	end()
+	tr.converted("a")
+	tr.converted("b")
+	recent, overlap, end = tr.begin("a", "creds1")
+	if !recent || overlap {
+		t.Fatal("completed key tracking incorrect")
+	}
+	end()
+	tr.converted("c")
+	recent, _, end = tr.begin("b", "creds1")
+	if recent {
+		t.Fatal("LRU key was not evicted")
+	}
+	end()
+	if len(tr.recent) != 2 || len(tr.active) != 0 {
+		t.Fatal("tracker exceeded bound or leaked active keys")
+	}
+}
+
+func TestKeyTrackerActiveBound(t *testing.T) {
+	tr := keyTracker{limit: 1}
+	_, _, end := tr.begin("a", "creds1")
+	_, overlap, overflowEnd := tr.begin("b", "creds1")
+	if overlap || len(tr.active) != 1 {
+		t.Fatal("overflow tracking is unbounded")
+	}
+	overflowEnd()
+	end()
+	if len(tr.active) != 0 {
+		t.Fatal("overflow cleanup corrupted active set")
+	}
+}
+
+func TestKeyTrackerConcurrent(t *testing.T) {
+	tr := keyTracker{limit: 2}
+	var wg sync.WaitGroup
+	for range 100 {
+		wg.Go(func() {
+			_, _, end := tr.begin("a", "creds1")
+			tr.converted("a")
+			end()
+		})
+	}
+	wg.Wait()
+	if len(tr.active) != 0 || len(tr.recent) != 1 {
+		t.Fatal("concurrent bookkeeping incorrect")
+	}
+}
+
+func TestKeyTrackerSameCredentialsNotOverlap(t *testing.T) {
+	tr := keyTracker{limit: 2}
+	_, _, end := tr.begin("a", "creds1")
+	_, overlap, end2 := tr.begin("a", "creds1")
+	if overlap {
+		t.Fatal("same credentials counted as credential overlap")
+	}
+	end()
+	end2()
+	if tr.activeEntries != 0 {
+		t.Fatal("active flight leaked")
+	}
+}
+
+func TestKeyTrackerBoundsCredentialsForOneImage(t *testing.T) {
+	tr := keyTracker{limit: 2}
+	var ends []func()
+	for _, flight := range []string{"creds1", "creds2", "creds3", "creds4"} {
+		_, _, end := tr.begin("a", flight)
+		ends = append(ends, end)
+	}
+	if tr.activeEntries != 2 || len(tr.active["a"]) != 2 {
+		t.Fatal("credential hashes exceeded active bound")
+	}
+	for _, end := range ends {
+		end()
+	}
+	if tr.activeEntries != 0 || len(tr.active) != 0 {
+		t.Fatal("bounded flights leaked")
+	}
+}
+
+func counterValue(t *testing.T, counter prometheus.Counter) float64 {
+	t.Helper()
+	m := &dto.Metric{}
+	require.NoError(t, counter.Write(m))
+	return m.GetCounter().GetValue()
+}
+
+// Done is evaluated by singleflight's select after the caller has joined the
+// flight. This barrier makes waiter tests deterministic without scheduling sleeps.
+type joiningContext struct {
+	context.Context
+	joined chan struct{}
+	once   sync.Once
+}
+
+func (c *joiningContext) Done() <-chan struct{} {
+	c.once.Do(func() { close(c.joined) })
+	return c.Context.Done()
+}
+func waitFor(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(10 * time.Second):
+		t.Fatal("timed out waiting for flight")
+	}
+}
+
+func TestSingleflightMetricsLeaderWaitersAndCancellation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	before := counterValue(t, metrics.Ext4ImageDedupedWaiters)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	leaderResult := make(chan error, 1)
+	var executions atomic.Int32
+	fn := func(ctx context.Context) (string, error) {
+		executions.Add(1)
+		close(started)
+		select {
+		case <-release:
+			return "image", nil
+		case <-ctx.Done():
+			return "", ctx.Err()
+		}
+	}
+	go func() { _, err := doConversionFlight(ctx, t.Name(), fn); leaderResult <- err }()
+	waitFor(t, started)
+	results := make(chan error, 3)
+	for range 3 {
+		waiter := &joiningContext{Context: ctx, joined: make(chan struct{})}
+		go func() { _, err := doConversionFlight(waiter, t.Name(), fn); results <- err }()
+		waitFor(t, waiter.joined)
+	}
+	canceled, cancelWaiter := context.WithCancel(ctx)
+	waiter := &joiningContext{Context: canceled, joined: make(chan struct{})}
+	canceledResult := make(chan error, 1)
+	go func() { _, err := doConversionFlight(waiter, t.Name(), fn); canceledResult <- err }()
+	waitFor(t, waiter.joined)
+	cancelWaiter()
+	require.ErrorIs(t, <-canceledResult, context.Canceled)
+	require.Equal(t, before, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+	close(release)
+	require.NoError(t, <-leaderResult)
+	for range 3 {
+		require.NoError(t, <-results)
+	}
+	require.Equal(t, int32(1), executions.Load())
+	require.Equal(t, before+3, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+	// An unshared leader must not count either.
+	_, err := doConversionFlight(ctx, t.Name()+"-solo", func(context.Context) (string, error) { return "image", nil })
+	require.NoError(t, err)
+	require.Equal(t, before+3, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+}
+
+func TestSingleflightMetricsCanceledLeaderWithLiveWaiter(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	leaderCtx, cancelLeader := context.WithCancel(ctx)
+	before := counterValue(t, metrics.Ext4ImageDedupedWaiters)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	fn := func(ctx context.Context) (string, error) {
+		close(started)
+		select {
+		case <-release:
+			return "image", ctx.Err()
+		case <-ctx.Done():
+			return "", ctx.Err()
+		}
+	}
+	leader := make(chan error, 1)
+	go func() { _, err := doConversionFlight(leaderCtx, t.Name(), fn); leader <- err }()
+	waitFor(t, started)
+	waiter := &joiningContext{Context: ctx, joined: make(chan struct{})}
+	result := make(chan error, 1)
+	go func() { _, err := doConversionFlight(waiter, t.Name(), fn); result <- err }()
+	waitFor(t, waiter.joined)
+	cancelLeader()
+	require.ErrorIs(t, <-leader, context.Canceled)
+	require.Equal(t, before, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+	close(release)
+	require.NoError(t, <-result)
+	require.Equal(t, before+1, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+}
+
+func TestSingleflightMetricsDistinctCredentials(t *testing.T) {
+	flags.Set(t, "executor.ext4_conversion_track_keys", true)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	parts := []string{t.Name(), "image"}
+	started := make(chan struct{}, 2)
+	release := make(chan struct{})
+	results := make(chan error, 2)
+	overlap := metrics.Ext4ImageCredentialOverlap.WithLabelValues("bounded")
+	before := counterValue(t, overlap)
+	beforeDedup := counterValue(t, metrics.Ext4ImageDedupedWaiters)
+	for _, credential := range []string{"first", "second"} {
+		flight := hash.Strings(append(parts, credential)...)
+		go func() {
+			_, err := doConversionFlight(ctx, flight, func(ctx context.Context) (string, error) {
+				finish := observeConversion(parts, flight, true)
+				defer finish(false)
+				started <- struct{}{}
+				select {
+				case <-release:
+					return "image", nil
+				case <-ctx.Done():
+					return "", ctx.Err()
+				}
+			})
+			results <- err
+		}()
+	}
+	for range 2 {
+		waitFor(t, started)
+	}
+	require.Equal(t, before+1, counterValue(t, overlap))
+	close(release)
+	for range 2 {
+		require.NoError(t, <-results)
+	}
+	require.Equal(t, beforeDedup, counterValue(t, metrics.Ext4ImageDedupedWaiters))
+}
+
+type conversionFixture struct {
+	ctx       context.Context
+	resolver  *oci.Resolver
+	cache     interfaces.FileCache
+	root, ref string
+}
+
+func newConversionFixture(t *testing.T) *conversionFixture {
+	t.Helper()
+	flags.Set(t, "executor.container_registry_allowed_private_ips", []string{"127.0.0.1/32"})
+	flags.Set(t, "executor.local_cache_store_ext4_images", true)
+	flags.Set(t, "executor.reproducible_ext4_images", false)
+	root := t.TempDir()
+	fc, err := filecache.NewFileCache(filepath.Join(root, "filecache"), 1_000_000_000, false)
+	require.NoError(t, err)
+	te := testenv.GetTestEnv(t)
+	te.SetFileCache(fc)
+	reg := testregistry.Run(t, testregistry.Opts{})
+	t.Cleanup(func() { require.NoError(t, reg.Shutdown()) })
+	ref, _ := reg.PushNamedImageWithFiles(t, "metrics-image:latest", map[string][]byte{"/data": []byte("conversion metrics")}, nil)
+	resolver, err := oci.NewResolver(te)
+	require.NoError(t, err)
+	return &conversionFixture{ctx: context.Background(), resolver: resolver, cache: fc, root: root, ref: ref}
+}
+func (f *conversionFixture) convert(output string) error {
+	return CreateDiskImage(f.ctx, f.resolver, f.cache, f.root, f.ref, oci.Credentials{}, false, filepath.Join(f.root, output))
+}
+
+func TestConversionPhaseAccountingEndToEnd(t *testing.T) {
+	flags.Set(t, "executor.ext4_conversion_sample_process_io", true)
+	flags.Set(t, "executor.ext4_conversion_sample_image_size", true)
+	fixture := newConversionFixture(t)
+	phases := []string{"extract", "size", "mke2fs", "filecache_add", "cleanup"}
+	counts := func() map[string]uint64 {
+		out := make(map[string]uint64)
+		for _, phase := range phases {
+			m := &dto.Metric{}
+			require.NoError(t, metrics.Ext4ImagePhaseDurationUsec.WithLabelValues(phase).(prometheus.Metric).Write(m))
+			out[phase] = m.GetHistogram().GetSampleCount()
+			for _, direction := range []string{"read", "write"} {
+				require.NoError(t, metrics.Ext4ImagePhaseIOBytes.WithLabelValues(phase, "process", direction).(prometheus.Metric).Write(m))
+				out[phase+direction] = m.GetHistogram().GetSampleCount()
+			}
+		}
+		for _, kind := range []string{"apparent", "allocated"} {
+			m := &dto.Metric{}
+			require.NoError(t, metrics.Ext4ImageSizeBytes.WithLabelValues(kind).(prometheus.Metric).Write(m))
+			out[kind] = m.GetHistogram().GetSampleCount()
+		}
+		return out
+	}
+	before := counts()
+	for n := range 2 {
+		require.NoError(t, fixture.convert(fmt.Sprintf("image-%d.ext4", n)))
+		after := counts()
+		for key, count := range before {
+			require.Equal(t, count+uint64(n+1), after[key], "accounting for %s", key)
+		}
+		// Explicit removal simulates eviction from the real filecache. Each new
+		// conversion executes both the unpack-dir and temp-image cleanup defers.
+		require.True(t, fixture.cache.DeleteFile(sharedFileCacheContext(fixture.ctx, fixture.cache), diskImageFileNode(fixture.ref)))
+	}
+	require.Empty(t, mustGlob(t, filepath.Join(fixture.root, "unpack-*")))
+	require.Empty(t, mustGlob(t, filepath.Join(fixture.root, "containerfs-*.ext4")))
+}
+func mustGlob(t *testing.T, pattern string) []string {
+	t.Helper()
+	matches, err := filepath.Glob(pattern)
+	require.NoError(t, err)
+	return matches
+}
+
+func TestReconversionAfterEvictionMetrics(t *testing.T) {
+	for _, enabled := range []bool{true, false} {
+		t.Run(fmt.Sprint(enabled), func(t *testing.T) {
+			flags.Set(t, "executor.ext4_conversion_track_keys", enabled)
+			fixture := newConversionFixture(t)
+			recent := metrics.Ext4ImageReConversions.WithLabelValues("true")
+			unseen := metrics.Ext4ImageReConversions.WithLabelValues("false")
+			beforeRecent, beforeUnseen := counterValue(t, recent), counterValue(t, unseen)
+			require.NoError(t, fixture.convert("first.ext4"))
+			require.True(t, fixture.cache.DeleteFile(sharedFileCacheContext(fixture.ctx, fixture.cache), diskImageFileNode(fixture.ref)))
+			require.NoError(t, fixture.convert("second.ext4"))
+			require.True(t, fixture.cache.DeleteFile(sharedFileCacheContext(fixture.ctx, fixture.cache), diskImageFileNode(fixture.ref)))
+			// An existing non-directory workspace makes extraction fail after the
+			// miss/attempt has been observed. Failed attempts must not seed history.
+			failedRoot := filepath.Join(fixture.root, "not-a-directory")
+			require.NoError(t, os.WriteFile(failedRoot, []byte("x"), 0600))
+			originalRoot := fixture.root
+			fixture.root = failedRoot
+			require.Error(t, fixture.convert("failed.ext4"))
+			require.Error(t, fixture.convert("failed-again.ext4"))
+			fixture.root = originalRoot
+			require.NoError(t, fixture.convert("third.ext4"))
+			if enabled {
+				require.Equal(t, beforeRecent+2, counterValue(t, recent))
+				require.Equal(t, beforeUnseen+3, counterValue(t, unseen))
+			} else {
+				require.Equal(t, beforeRecent, counterValue(t, recent))
+				require.Equal(t, beforeUnseen, counterValue(t, unseen))
+			}
+		})
+	}
+}
+
+func TestRootConversionPhaseAccountingWithDeviceNode(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("device-node conversion requires root")
+	}
+	fixture := newConversionFixture(t)
+	flags.Set(t, "executor.exclude_root_device_nodes", false)
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	require.NoError(t, tw.WriteHeader(&tar.Header{Name: "dev", Typeflag: tar.TypeDir, Mode: 0755}))
+	require.NoError(t, tw.WriteHeader(&tar.Header{Name: "dev/null", Typeflag: tar.TypeChar, Mode: 0666, Devmajor: 1, Devminor: 3}))
+	require.NoError(t, tw.Close())
+	image, err := mutate.AppendLayers(empty.Image, testregistry.NewBytesLayer(t, buf.Bytes()))
+	require.NoError(t, err)
+	reg := testregistry.Run(t, testregistry.Opts{})
+	t.Cleanup(func() { require.NoError(t, reg.Shutdown()) })
+	fixture.ref = reg.Push(t, image, "device-image", nil)
+	before := &dto.Metric{}
+	cleanup := metrics.Ext4ImagePhaseDurationUsec.WithLabelValues("cleanup").(prometheus.Metric)
+	require.NoError(t, cleanup.Write(before))
+	require.NoError(t, fixture.convert("device.ext4"))
+	after := &dto.Metric{}
+	require.NoError(t, cleanup.Write(after))
+	require.Equal(t, before.GetHistogram().GetSampleCount()+1, after.GetHistogram().GetSampleCount())
+	out, err := exec.Command("/sbin/debugfs", "-R", "stat /dev/null", filepath.Join(fixture.root, "device.ext4")).CombinedOutput()
+	require.NoError(t, err)
+	require.Contains(t, string(out), "Type: character special")
+}
