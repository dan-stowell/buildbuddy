+	leaf := addDir(&repb.Directory{Files: []*repb.FileNode{{Name: "leaf"}}}, false)
+	left := addDir(&repb.Directory{Directories: []*repb.DirectoryNode{{Name: "leaf", Digest: leaf}}}, true)
+	right := addDir(&repb.Directory{Files: []*repb.FileNode{{Name: "right"}}}, false)
+	root := addDir(&repb.Directory{Directories: []*repb.DirectoryNode{{Name: "left", Digest: left}, {Name: "right", Digest: right}}}, true)
