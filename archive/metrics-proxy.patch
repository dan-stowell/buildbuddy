@@ -0,0 +1,115 @@
+package action_cache_server_proxy
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/buildbuddy-io/buildbuddy/server/interfaces"
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/buildbuddy-io/buildbuddy/server/testutil/testauth"
+	"github.com/buildbuddy-io/buildbuddy/server/testutil/testenv"
+	"github.com/buildbuddy-io/buildbuddy/server/util/status"
+	"github.com/buildbuddy-io/buildbuddy/server/util/testing/flags"
+	"github.com/jonboulle/clockwork"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+
+	repb "github.com/buildbuddy-io/buildbuddy/proto/remote_execution"
+	rspb "github.com/buildbuddy-io/buildbuddy/proto/resource"
+	dto "github.com/prometheus/client_model/go"
+)
+
+type revalidationClient struct {
+	repb.ActionCacheClient
+	outcome string
+}
+
+func (c *revalidationClient) GetActionResult(ctx context.Context, req *repb.GetActionResultRequest, _ ...grpc.CallOption) (*repb.ActionResult, error) {
+	switch c.outcome {
+	case "unchanged":
+		return &repb.ActionResult{ActionResultDigest: req.GetCachedActionResultDigest()}, nil
+	case "error":
+		return nil, status.UnavailableError("remote unavailable")
+	default:
+		return &repb.ActionResult{ExitCode: 2}, nil
+	}
+}
+
+type observingMetadataCache struct {
+	*localOnlyCache
+	calls int
+	fail  bool
+}
+
+func (c *observingMetadataCache) Metadata(ctx context.Context, r *rspb.ResourceName) (*interfaces.CacheMetadata, error) {
+	c.calls++
+	if c.fail {
+		return nil, status.UnavailableError("metadata unavailable")
+	}
+	return c.localOnlyCache.Metadata(ctx, r)
+}
+func changedAgeSnapshot(t *testing.T) (uint64, float64) {
+	t.Helper()
+	m := &dto.Metric{}
+	require.NoError(t, metrics.CacheProxyACChangedAgeSeconds.WithLabelValues().(prometheus.Metric).Write(m))
+	return m.GetHistogram().GetSampleCount(), m.GetHistogram().GetSampleSum()
+}
+func TestActionCacheRevalidationObservations(t *testing.T) {
+	for _, tc := range []struct {
+		name, outcome          string
+		observe, metadataError bool
+	}{
+		{"unchanged", "unchanged", true, false},
+		{"changed", "changed", true, false},
+		{"remote_error", "error", true, false},
+		{"metadata_error_is_ignored", "changed", true, true},
+		{"default_off_has_no_extra_lookup", "changed", false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			flags.Set(t, "cache_proxy.cache_action_results", true)
+			flags.Set(t, "cache_proxy.observe_action_cache_age", tc.observe)
+			env := testenv.GetTestEnv(t)
+			now := time.Unix(2000, 0)
+			env.SetClock(clockwork.NewFakeClockAt(now))
+			ta := testauth.NewTestAuthenticator(t, testauth.TestUsers("user", "GR123"))
+			env.SetAuthenticator(ta)
+			ctx, err := ta.WithAuthenticatedUser(context.Background(), "user")
+			require.NoError(t, err)
+			req := &repb.GetActionResultRequest{ActionDigest: &repb.Digest{Hash: strings.Repeat("a", 64), SizeBytes: 1}, DigestFunction: repb.DigestFunction_SHA256}
+			cache := &observingMetadataCache{localOnlyCache: newLocalOnlyCache(), fail: tc.metadataError}
+			seedLocalActionResult(t, cache.localOnlyCache, req, &repb.ActionResult{ExitCode: 1}, now.Add(-2*time.Minute).UnixMicro())
+			proxy := &ActionCacheServerProxy{env: env, authenticator: ta, localCache: cache, remoteACClient: &revalidationClient{outcome: tc.outcome}}
+			counter := metrics.CacheProxyACRevalidations.WithLabelValues(tc.outcome)
+			before := testutil.ToFloat64(counter)
+			count, sum := changedAgeSnapshot(t)
+			resp, err := proxy.GetActionResult(ctx, req)
+			if tc.outcome == "error" {
+				require.True(t, status.IsUnavailableError(err))
+			} else {
+				require.NoError(t, err)
+				want := int32(2)
+				if tc.outcome == "unchanged" {
+					want = 1
+				}
+				require.Equal(t, want, resp.GetExitCode())
+			}
+			require.Equal(t, float64(1), testutil.ToFloat64(counter)-before)
+			afterCount, afterSum := changedAgeSnapshot(t)
+			if tc.observe && tc.outcome == "changed" && !tc.metadataError {
+				require.Equal(t, count+1, afterCount)
+				require.Equal(t, float64(120), afterSum-sum)
+			} else {
+				require.Equal(t, count, afterCount)
+			}
+			if tc.observe {
+				require.Equal(t, 1, cache.calls)
+			} else {
+				require.Zero(t, cache.calls)
+			}
+		})
+	}
+}
