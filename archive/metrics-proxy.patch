@@ -0,0 +1,186 @@
+package proxy_util
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	repb "github.com/buildbuddy-io/buildbuddy/proto/remote_execution"
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	dto "github.com/prometheus/client_model/go"
+	bspb "google.golang.org/genproto/googleapis/bytestream"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/stats"
+	"google.golang.org/grpc/status"
+)
+
+func TestRecentTrackerWindowsAndBatchDuplicates(t *testing.T) {
+	tracker := NewRecentTracker(10)
+	now := time.Unix(1000, 0)
+	if got := tracker.ObserveBatch([]string{"a", "a"}, now); got != [3]int{} {
+		t.Fatal(got)
+	}
+	if got := tracker.ObserveBatch([]string{"a", "a"}, now.Add(time.Minute)); got != [3]int{2, 2, 2} {
+		t.Fatal(got)
+	}
+	if got := tracker.ObserveBatch([]string{"a"}, now.Add(3*time.Minute)); got != [3]int{0, 1, 1} {
+		t.Fatal(got)
+	}
+	if got := tracker.ObserveBatch([]string{"a"}, now.Add(9*time.Minute)); got != [3]int{0, 0, 1} {
+		t.Fatal(got)
+	}
+	if got := tracker.ObserveBatch([]string{"a"}, now.Add(25*time.Minute)); got != [3]int{} {
+		t.Fatal(got)
+	}
+}
+func TestRecentTrackerEvictionAndIsolation(t *testing.T) {
+	tracker := NewRecentTracker(2)
+	now := time.Now()
+	tracker.ObserveBatch([]string{"group1/blob", "group2/blob"}, now)
+	tracker.ObserveBatch([]string{"group1/blob"}, now)
+	tracker.ObserveBatch([]string{"other"}, now)
+	if got := tracker.ObserveBatch([]string{"group2/blob", "group1/blob"}, now); got != [3]int{1, 1, 1} {
+		t.Fatal(got)
+	}
+	if len(tracker.entries) != 2 {
+		t.Fatal(len(tracker.entries))
+	}
+	if got := NewRecentTracker(0).ObserveBatch([]string{"a"}, now); got != [3]int{} {
+		t.Fatal(got)
+	}
+}
+func TestRecentTrackerConcurrentBound(t *testing.T) {
+	tracker := NewRecentTracker(16)
+	var wg sync.WaitGroup
+	for i := range 8 {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := range 100 {
+				tracker.ObserveBatch([]string{fmt.Sprintf("%d/%d", i, j)}, time.Now())
+			}
+		}(i)
+	}
+	wg.Wait()
+	if len(tracker.entries) != 16 {
+		t.Fatal(len(tracker.entries))
+	}
+}
+func TestRemoteObservationUsesFinalLocalOutcome(t *testing.T) {
+	ctx, o := StartObservation(context.Background())
+	h := RemoteStatsHandler{}
+	method := "build.bazel.remote.execution.v2.ContentAddressableStorage/SplitBlob"
+	ctx = h.TagRPC(ctx, &stats.RPCTagInfo{FullMethodName: "/" + method})
+	counter := metrics.CacheProxyRemoteRPCs.WithLabelValues(method, "hit")
+	before := testutil.ToFloat64(counter)
+	wasted := testutil.ToFloat64(metrics.CacheProxySplitBlobLocalHits.WithLabelValues())
+	sent := metrics.CacheProxyRemoteBytes.WithLabelValues(method, "sent", "hit")
+	sentBefore := testutil.ToFloat64(sent)
+	h.HandleRPC(ctx, &stats.Begin{})
+	h.HandleRPC(ctx, &stats.OutPayload{Length: 100, CompressedLength: 42})
+	h.HandleRPC(ctx, &stats.End{Error: status.Error(codes.NotFound, "missing")})
+	SetLocalOutcome(ctx, "hit")
+	o.Finish()
+	o.Finish()
+	if got := testutil.ToFloat64(counter) - before; got != 1 {
+		t.Fatal(got)
+	}
+	if got := testutil.ToFloat64(metrics.CacheProxySplitBlobLocalHits.WithLabelValues()) - wasted; got != 1 {
+		t.Fatal(got)
+	}
+	if got := testutil.ToFloat64(sent) - sentBefore; got != 42 {
+		t.Fatal(got)
+	}
+	// Background work which outlives the handler is still accounted for.
+	h.HandleRPC(ctx, &stats.Begin{})
+	if got := testutil.ToFloat64(counter) - before; got != 2 {
+		t.Fatal(got)
+	}
+}
+func TestRemoteBatchBlobBytes(t *testing.T) {
+	h := RemoteStatsHandler{}
+	method := "build.bazel.remote.execution.v2.ContentAddressableStorage/BatchReadBlobs"
+	ctx := h.TagRPC(context.Background(), &stats.RPCTagInfo{FullMethodName: "/" + method})
+	identity := metrics.CacheProxyLinkBlobBytes.WithLabelValues(method, "received", "identity")
+	compressed := metrics.CacheProxyLinkBlobBytes.WithLabelValues(method, "received", "zstd")
+	a, b := testutil.ToFloat64(identity), testutil.ToFloat64(compressed)
+	h.HandleRPC(ctx, &stats.InPayload{Length: 100, Payload: &repb.BatchReadBlobsResponse{Responses: []*repb.BatchReadBlobsResponse_Response{{Data: []byte("abc")}, {Data: []byte("xy"), Compressor: repb.Compressor_ZSTD}}}})
+	if testutil.ToFloat64(identity)-a != 3 || testutil.ToFloat64(compressed)-b != 2 {
+		t.Fatal("incorrect blob accounting")
+	}
+}
+
+func TestStreamingSamplingBoundsAndPartialReads(t *testing.T) {
+	old := *IdentityZstdSampleEvery
+	*IdentityZstdSampleEvery = 1
+	defer func() { *IdentityZstdSampleEvery = old }()
+	h := RemoteStatsHandler{}
+	for _, tc := range []struct {
+		name     string
+		offset   int64
+		size     int
+		wantHeld bool
+	}{
+		{"small", 0, 32, true}, {"oversize", 0, (1 << 20) + 1, false}, {"partial", 1, 32, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := h.TagRPC(context.Background(), &stats.RPCTagInfo{FullMethodName: "/google.bytestream.ByteStream/Read"})
+			h.HandleRPC(ctx, &stats.OutPayload{Payload: &bspb.ReadRequest{ResourceName: "blobs/" + strings.Repeat("a", 64) + "/32", ReadOffset: tc.offset}})
+			h.HandleRPC(ctx, &stats.InPayload{Payload: &bspb.ReadResponse{Data: make([]byte, tc.size)}})
+			r := ctx.Value(rpcObservationKey{}).(*rpcObservation)
+			if r.sampleHeld != tc.wantHeld || len(r.sampleData) > 1<<20 {
+				t.Fatalf("held=%v buffer=%d", r.sampleHeld, len(r.sampleData))
+			}
+			// A failed RPC releases its sample without observing a ratio.
+			h.HandleRPC(ctx, &stats.End{Error: status.Error(codes.Canceled, "cancelled")})
+			if r.sampleHeld || r.sampleData != nil {
+				t.Fatal("sample retained after end")
+			}
+		})
+	}
+	if len(sampleSlots) != 0 {
+		t.Fatal("sample slots leaked")
+	}
+}
+func TestRemoteMethodLabelsAreBounded(t *testing.T) {
+	h := RemoteStatsHandler{}
+	for _, method := range []string{"/google.bytestream.ByteStream/arbitrary-blob-name", "/arbitrary-service/Read"} {
+		ctx := h.TagRPC(context.Background(), &stats.RPCTagInfo{FullMethodName: method})
+		if ctx.Value(rpcObservationKey{}).(*rpcObservation).method != "other" {
+			t.Fatal("unbounded label")
+		}
+	}
+}
+
+func TestStreamingSampleRequiresSuccessfulCompleteBlob(t *testing.T) {
+	old := *IdentityZstdSampleEvery
+	*IdentityZstdSampleEvery = 1
+	defer func() { *IdentityZstdSampleEvery = old }()
+	method := "google.bytestream.ByteStream/Read"
+	snapshot := func() uint64 {
+		m := &dto.Metric{}
+		if err := metrics.CacheProxyIdentityZstdRatio.WithLabelValues(method, "received").(prometheus.Metric).Write(m); err != nil {
+			t.Fatal(err)
+		}
+		return m.GetHistogram().GetSampleCount()
+	}
+	before := snapshot()
+	h := RemoteStatsHandler{}
+	for _, size := range []int{32, 16} {
+		ctx := h.TagRPC(context.Background(), &stats.RPCTagInfo{FullMethodName: "/" + method})
+		h.HandleRPC(ctx, &stats.OutPayload{Payload: &bspb.ReadRequest{ResourceName: "blobs/" + strings.Repeat("a", 64) + "/32"}})
+		h.HandleRPC(ctx, &stats.InPayload{Payload: &bspb.ReadResponse{Data: make([]byte, size)}})
+		h.HandleRPC(ctx, &stats.End{})
+	}
+	if got := snapshot() - before; got != 1 {
+		t.Fatal(got)
+	}
+	if len(sampleSlots) != 0 {
+		t.Fatal("sample slots leaked")
+	}
+}
