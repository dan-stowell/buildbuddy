+func TestPartialReadLocalWriteObservations(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		offset, limit int64
+		outcome       string
+	}{
+		{name: "full_blob_with_limit_commits", limit: 1024, outcome: "committed"},
+		{name: "offset_fails_validation", offset: 1, outcome: "failed"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := testContext()
+			remoteEnv := testenv.GetTestEnv(t)
+			proxyEnv := testenv.GetTestEnv(t)
+			remote, _, _, _ := runRemoteServices(ctx, remoteEnv, t)
+			proxy := runBSProxy(ctx, remote, proxyEnv, t)
+			localCtx, err := prefix.AttachUserPrefixToContext(ctx, proxyEnv.GetAuthenticator())
+			require.NoError(t, err)
+			remoteCtx, err := prefix.AttachUserPrefixToContext(ctx, remoteEnv.GetAuthenticator())
+			require.NoError(t, err)
+			resource, data := testdigest.RandomCASResourceBuf(t, 1024)
+			rn, err := digest.CASResourceNameFromProto(resource)
+			require.NoError(t, err)
+			require.NoError(t, remoteEnv.GetCache().Set(remoteCtx, rn.ToProto(), data))
+			beforeMisses := testutil.ToFloat64(metrics.CacheProxyPartialReadMisses.WithLabelValues())
+			beforeCommitted := testutil.ToFloat64(metrics.CacheProxyPartialReadWrites.WithLabelValues("committed"))
+			beforeFailed := testutil.ToFloat64(metrics.CacheProxyPartialReadWrites.WithLabelValues("failed"))
+			stream, err := proxy.Read(ctx, &bspb.ReadRequest{ResourceName: rn.DownloadString(), ReadOffset: tc.offset, ReadLimit: tc.limit})
+			require.NoError(t, err)
+			var got []byte
+			for {
+				resp, err := stream.Recv()
+				if err == io.EOF {
+					break
+				}
+				require.NoError(t, err)
+				got = append(got, resp.Data...)
+			}
+			require.Equal(t, data[tc.offset:], got)
+			require.Equal(t, beforeMisses+1, testutil.ToFloat64(metrics.CacheProxyPartialReadMisses.WithLabelValues()))
+			committedDelta, failedDelta := float64(0), float64(0)
+			if tc.outcome == "committed" {
+				committedDelta = 1
+			} else {
+				failedDelta = 1
+			}
+			require.Equal(t, beforeCommitted+committedDelta, testutil.ToFloat64(metrics.CacheProxyPartialReadWrites.WithLabelValues("committed")))
+			require.Equal(t, beforeFailed+failedDelta, testutil.ToFloat64(metrics.CacheProxyPartialReadWrites.WithLabelValues("failed")))
+			found, err := proxyEnv.GetCache().Contains(localCtx, rn.ToProto())
+			require.NoError(t, err)
+			require.Equal(t, tc.outcome == "committed", found)
+		})
+	}
+}
