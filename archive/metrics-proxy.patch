+package proxy_util
+
+import (
+	"container/list"
+	"context"
+	"crypto/sha256"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	ofpb "github.com/buildbuddy-io/buildbuddy/proto/oci_fetcher"
+	repb "github.com/buildbuddy-io/buildbuddy/proto/remote_execution"
+	"github.com/buildbuddy-io/buildbuddy/server/metrics"
+	"github.com/buildbuddy-io/buildbuddy/server/remote_cache/digest"
+	"github.com/buildbuddy-io/buildbuddy/server/util/flag"
+	"github.com/klauspost/compress/zstd"
+	bspb "google.golang.org/genproto/googleapis/bytestream"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/stats"
+	"google.golang.org/grpc/status"
+)
+
+var IdentityZstdSampleEvery = flag.Int("cache_proxy.identity_zstd_sample_every", 0, "Observe-only: compress 1 in N complete identity blobs on the app link, skipping blobs over 1 MiB. Default off (0); adds request-path CPU, with at most two concurrent samples and bounded buffers.")
+var ObserveACAge = flag.Bool("cache_proxy.observe_action_cache_age", false, "Observe-only: fetch local AC metadata to measure the age of changed results. Default off; adds metadata work on local reads.")
+var ObserveFindMissing = flag.Bool("cache_proxy.observe_find_missing_reuse", false, "Observe-only: track requested FindMissingBlobs digests in a fixed 100,000-entry LRU to measure reuse within 1, 5 and 15 minutes. Default off; adds authentication and bounded tracking work per request.")
+
+type observationKey struct{}
+type remoteKey struct{ method, direction, compressor string }
+
+// Observation defers remote accounting until the request or batch's local outcome is known.
+// Only bounded method/direction/compressor aggregates are retained, never payloads.
+type Observation struct {
+	mu            sync.Mutex
+	outcome       string
+	counts        map[remoteKey]int64
+	finished      bool
+	splitNotFound bool
+}
+
+// StartObservation creates an independent scope, shadowing any parent observation.
+// Use a new scope when one request issues batches with different local outcomes.
+func StartObservation(ctx context.Context) (context.Context, *Observation) {
+	o := &Observation{outcome: "not_checked", counts: make(map[remoteKey]int64)}
+	return context.WithValue(ctx, observationKey{}, o), o
+}
+func SetLocalOutcome(ctx context.Context, outcome string) {
+	switch outcome {
+	case "hit", "miss", "partial", "uncacheable", "not_checked":
+	default:
+		outcome = "not_checked"
+	}
+	if o, ok := ctx.Value(observationKey{}).(*Observation); ok {
+		o.mu.Lock()
+		o.outcome = outcome
+		o.mu.Unlock()
+	}
+}
+func emitRemote(k remoteKey, n int64, outcome string) {
+	if k.direction == "" {
+		metrics.CacheProxyRemoteRPCs.WithLabelValues(k.method, outcome).Add(float64(n))
+	} else if k.compressor == "" {
+		metrics.CacheProxyRemoteBytes.WithLabelValues(k.method, k.direction, outcome).Add(float64(n))
+	} else {
+		metrics.CacheProxyLinkBlobBytes.WithLabelValues(k.method, k.direction, k.compressor).Add(float64(n))
+	}
+}
+func (o *Observation) Finish(errs ...error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished {
+		return
+	}
+	o.finished = true
+	for k, n := range o.counts {
+		emitRemote(k, n, o.outcome)
+	}
+	o.counts = nil
+	if o.splitNotFound && o.outcome == "hit" && (len(errs) == 0 || errs[0] == nil) {
+		metrics.CacheProxySplitBlobLocalHits.WithLabelValues().Inc()
+	}
+}
+func addRemote(ctx context.Context, k remoteKey, n int64) {
+	if o, ok := ctx.Value(observationKey{}).(*Observation); ok {
+		o.mu.Lock()
+		defer o.mu.Unlock()
+		if !o.finished {
+			o.counts[k] += n
+			return
+		}
+		emitRemote(k, n, o.outcome)
+		return
+	}
+	emitRemote(k, n, "not_checked")
+}
+func ObservationUnaryInterceptor(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (resp any, err error) {
+	ctx, o := StartObservation(ctx)
+	defer func() { o.Finish(err) }()
+	return handler(ctx, req)
+}
+
+type observedStream struct {
+	grpc.ServerStream
+	ctx context.Context
+}
+
+func (s *observedStream) Context() context.Context { return s.ctx }
+func ObservationStreamInterceptor(srv any, stream grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) (err error) {
+	ctx, o := StartObservation(stream.Context())
+	defer func() { o.Finish(err) }()
+	return handler(srv, &observedStream{ServerStream: stream, ctx: ctx})
+}
+
+type rpcObservationKey struct{}
+type rpcObservation struct {
+	sampleStarted   bool
+	sampleHeld      bool
+	sampleData      []byte
+	sampleDirection string
+	expectedSize    int64
+	mu              sync.Mutex
+	method          string
+	compressor      string
+}
+
+// RemoteStatsHandler must be installed only on proxy-to-app connections.
+// Local loopback traffic must not be counted as app-link traffic.
+type RemoteStatsHandler struct{}
+
+// Only documented proxy services are accepted; method labels never come from resource names.
+func (RemoteStatsHandler) TagRPC(ctx context.Context, info *stats.RPCTagInfo) context.Context {
+	parts := strings.Split(info.FullMethodName, "/")
+	method := "other"
+	if len(parts) == 3 {
+		switch parts[1] {
+		case "google.bytestream.ByteStream", "build.bazel.remote.execution.v2.ContentAddressableStorage", "build.bazel.remote.execution.v2.ActionCache", "build.bazel.remote.execution.v2.Capabilities", "oci_fetcher.OCIFetcher", "hit_tracker.HitTrackerService":
+			switch parts[2] {
+			case "Read", "Write", "QueryWriteStatus", "GetActionResult", "UpdateActionResult", "FindMissingBlobs", "BatchReadBlobs", "BatchUpdateBlobs", "GetTree", "SplitBlob", "SpliceBlob", "GetChunkMapping", "RegisterChunkMapping", "GetCapabilities", "FetchManifest", "FetchManifestMetadata", "FetchBlobMetadata", "FetchBlob", "Track":
+				method = parts[1] + "/" + parts[2]
+			}
+		}
+	}
+	compressor := "identity"
+	if strings.HasPrefix(method, "google.bytestream.ByteStream/") {
+		compressor = "unknown"
+	}
+	return context.WithValue(ctx, rpcObservationKey{}, &rpcObservation{method: method, compressor: compressor, expectedSize: -1})
+}
+func (RemoteStatsHandler) HandleRPC(ctx context.Context, event stats.RPCStats) {
+	r, ok := ctx.Value(rpcObservationKey{}).(*rpcObservation)
+	if !ok {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	switch e := event.(type) {
+	case *stats.Begin:
+		addRemote(ctx, remoteKey{method: r.method}, 1)
+	case *stats.OutPayload:
+		addRemote(ctx, remoteKey{method: r.method, direction: "sent"}, int64(e.CompressedLength))
+		r.payload(ctx, e.Payload, "sent")
+	case *stats.InPayload:
+		addRemote(ctx, remoteKey{method: r.method, direction: "received"}, int64(e.CompressedLength))
+		r.payload(ctx, e.Payload, "received")
+	case *stats.End:
+		if r.sampleHeld {
+			if e.Error == nil && len(r.sampleData) > 0 && (r.expectedSize < 0 || int64(len(r.sampleData)) == r.expectedSize) {
+				encodeIdentitySample(r.sampleData, r.method, r.sampleDirection)
+			}
+			r.sampleData = nil
+			r.sampleHeld = false
+			<-sampleSlots
+		}
+		if strings.HasSuffix(r.method, "/SplitBlob") && status.Code(e.Error) == codes.NotFound {
+			if o, ok := ctx.Value(observationKey{}).(*Observation); ok {
+				o.mu.Lock()
+				o.splitNotFound = true
+				o.mu.Unlock()
+			}
+		}
+	}
+}
+func (RemoteStatsHandler) TagConn(ctx context.Context, _ *stats.ConnTagInfo) context.Context {
+	return ctx
+}
+func (RemoteStatsHandler) HandleConn(context.Context, stats.ConnStats) {}
+func compressorName(c repb.Compressor_Value) string {
+	switch c {
+	case repb.Compressor_IDENTITY:
+		return "identity"
+	case repb.Compressor_ZSTD:
+		return "zstd"
+	default:
+		return "unknown"
+	}
+}
+func (r *rpcObservation) blob(ctx context.Context, data []byte, c string, direction string, complete bool) {
+	addRemote(ctx, remoteKey{method: r.method, direction: direction, compressor: c}, int64(len(data)))
+	if complete && c == "identity" {
+		sampleIdentity(data, r.method, direction)
+	} else if !complete && c == "identity" && len(data) > 0 {
+		if !r.sampleStarted {
+			r.sampleStarted = true
+			n := *IdentityZstdSampleEvery
+			if n > 0 && sampleSequence.Add(1)%uint64(n) == 0 {
+				select {
+				case sampleSlots <- struct{}{}:
+					r.sampleHeld = true
+					r.sampleData = make([]byte, 0, 1<<20)
+					r.sampleDirection = direction
+				default:
+				}
+			}
+		}
+		if r.sampleHeld {
+			if len(r.sampleData)+len(data) > 1<<20 {
+				r.sampleData = nil
+				r.sampleHeld = false
+				<-sampleSlots
+			} else {
+				r.sampleData = append(r.sampleData, data...)
+			}
+		}
+	}
+}
+func (r *rpcObservation) payload(ctx context.Context, p any, direction string) {
+	switch p := p.(type) {
+	case *bspb.ReadRequest:
+		if p.GetReadOffset() != 0 || p.GetReadLimit() != 0 {
+			r.sampleStarted = true
+		}
+		if rn, err := digest.ParseDownloadResourceName(p.GetResourceName()); err == nil {
+			r.compressor = compressorName(rn.GetCompressor())
+			r.expectedSize = rn.GetDigest().GetSizeBytes()
+			if r.expectedSize > 1<<20 {
+				r.sampleStarted = true
+			}
+		}
+	case *bspb.WriteRequest:
+		if !r.sampleStarted && p.GetWriteOffset() != 0 {
+			r.sampleStarted = true
+		}
+		if p.GetResourceName() != "" {
+			if rn, err := digest.ParseUploadResourceName(p.GetResourceName()); err == nil {
+				r.compressor = compressorName(rn.GetCompressor())
+				r.expectedSize = rn.GetDigest().GetSizeBytes()
+				if r.expectedSize > 1<<20 {
+					r.sampleStarted = true
+				}
+			}
+		}
+		r.blob(ctx, p.GetData(), r.compressor, direction, false)
+	case *bspb.ReadResponse:
+		r.blob(ctx, p.GetData(), r.compressor, direction, false)
+	case *repb.BatchUpdateBlobsRequest:
+		for _, b := range p.GetRequests() {
+			r.blob(ctx, b.GetData(), compressorName(b.GetCompressor()), direction, true)
+		}
+	case *repb.BatchReadBlobsResponse:
+		for _, b := range p.GetResponses() {
+			r.blob(ctx, b.GetData(), compressorName(b.GetCompressor()), direction, true)
+		}
+	case *ofpb.FetchBlobResponse:
+		r.blob(ctx, p.GetData(), "identity", direction, false)
+	}
+}
+
+var sampleSequence atomic.Uint64
+var sampleSlots = make(chan struct{}, 2)
+var sampleEncoderOnce sync.Once
+var sampleEncoder *zstd.Encoder
+
+func sampleIdentity(data []byte, method, direction string) {
+	n := *IdentityZstdSampleEvery
+	if n <= 0 || len(data) == 0 || len(data) > 1<<20 || sampleSequence.Add(1)%uint64(n) != 0 {
+		return
+	}
+	select {
+	case sampleSlots <- struct{}{}:
+		defer func() { <-sampleSlots }()
+	default:
+		return
+	}
+	encodeIdentitySample(data, method, direction)
+}
+func encodeIdentitySample(data []byte, method, direction string) {
+	sampleEncoderOnce.Do(func() { sampleEncoder, _ = zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1)) })
+	if sampleEncoder == nil {
+		return
+	}
+	compressed := sampleEncoder.EncodeAll(data, nil)
+	metrics.CacheProxyIdentityZstdRatio.WithLabelValues(method, direction).Observe(float64(len(compressed)) / float64(len(data)))
+}
+
+// RecentTracker retains fixed-size hashed keys. ObserveBatch tests all keys before
+// inserting, so duplicates in one request do not count as previous requests.
+type RecentTracker struct {
+	mu       sync.Mutex
+	capacity int
+	entries  map[[32]byte]*list.Element
+	order    *list.List
+}
+type recentEntry struct {
+	key  [32]byte
+	seen time.Time
+}
+
+func NewRecentTracker(capacity int) *RecentTracker {
+	return &RecentTracker{capacity: capacity, entries: make(map[[32]byte]*list.Element), order: list.New()}
+}
+func (t *RecentTracker) ObserveBatch(keys []string, now time.Time) [3]int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	var hits [3]int
+	windows := [3]time.Duration{time.Minute, 5 * time.Minute, 15 * time.Minute}
+	for _, key := range keys {
+		if e, ok := t.entries[sha256.Sum256([]byte(key))]; ok {
+			age := now.Sub(e.Value.(recentEntry).seen)
+			for i, w := range windows {
+				if age >= 0 && age <= w {
+					hits[i]++
+				}
+			}
+		}
+	}
+	if t.capacity <= 0 {
+		return hits
+	}
+	for _, key := range keys {
+		k := sha256.Sum256([]byte(key))
+		if e, ok := t.entries[k]; ok {
+			e.Value = recentEntry{k, now}
+			t.order.MoveToFront(e)
+		} else {
+			t.entries[k] = t.order.PushFront(recentEntry{k, now})
+		}
+		if t.order.Len() > t.capacity {
+			e := t.order.Back()
+			delete(t.entries, e.Value.(recentEntry).key)
+			t.order.Remove(e)
+		}
+	}
+	return hits
+}
diff --git a/enterprise/server/util/proxy_util/observations_test.go b/enterprise/server/util/proxy_util/observations_test.go
new file mode 100644
index 000000000..648dea29f
--- /dev/null
